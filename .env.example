# Heaven of Web — environment configuration
# Copy this file to ".env" (same folder) and fill in the values. Never commit .env.
# Values already set in the server environment (e.g. Docker) take precedence over this file.

# --- Application ---
# "production" on the live site, "local" for development (shows detailed errors)
APP_ENV=production
APP_URL=https://heavenofweb.fr
APP_NAME="Heaven of Web"
# Long random string: php -r "echo bin2hex(random_bytes(32));"
# Do not change it once two-factor authentication is in use (see DEPLOY.md).
APP_SECRET=
# One-time password used to create the first admin at /admin/setup
SETUP_KEY=
APP_TIMEZONE=Africa/Tunis

# --- Database (hPanel → Databases → MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# --- Email (hPanel → Emails). Hostinger: smtp.hostinger.com, 465, ssl ---
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_SECURE=ssl
MAIL_USER=contact@heavenofweb.fr
MAIL_PASS=
MAIL_FROM=contact@heavenofweb.fr
MAIL_FROM_NAME="Heaven of Web"
